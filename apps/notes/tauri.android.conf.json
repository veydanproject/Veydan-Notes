{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veydan Notes",
  "identifier": "net.veydan.notes",
  "build": {
    "devUrl": "http://localhost:1450",
    "frontendDist": "../../data/build/notes-android"
  },
  "app": {
    "windows": [
      {
        "title": "Veydan Notes",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1451 http://127.0.0.1:1450 ws://localhost:1451 http://localhost:1450",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "android": {
      "minSdkVersion": 26,
      "versionCode": 2050006
    }
  }
}
